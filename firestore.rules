// ============================================================
// REGRAS DO FIRESTORE — Rastreamento de Cargas + Controle de Frota
// Os dois painéis usam o mesmo projeto Firebase.
// Console Firebase > Firestore Database > Regras > apagar tudo > colar > Publicar
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rastreamento de Cargas (já existentes)
    match /notas/{id}              { allow read: if true; allow write: if request.auth != null; }
    match /historico/{id}          { allow read: if true; allow write: if request.auth != null; }
    match /resumo_diario/{id}      { allow read: if true; allow write: if request.auth != null; }

    // Controle de Frota (novas)
    match /frota/{id}              { allow read: if true; allow write: if request.auth != null; }
    match /frota_historico/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /frota_afastamentos/{id} { allow read: if true; allow write: if request.auth != null; }
    match /frota_colaboradores/{id} { allow read: if true; allow write: if request.auth != null; }
    match /frota_checklists/{id}    { allow read: if true; allow write: if request.auth != null; }
  }
}
